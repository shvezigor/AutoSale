generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  generatedFileExtension = "ts"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id        String         @id @default(uuid()) @db.Uuid
  key       String         @unique
  name      String
  createdAt DateTime       @default(now()) @map("created_at")
  events    WebhookEvent[]
  conversations Conversation[]
  messages      Message[]
  settings      TenantSettings?
  orders        Order[]
  products      Product[]

  @@map("tenants")
}

model WebhookEvent {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  provider        String
  externalEventId String    @map("external_event_id")
  payload         Json
  status          String    @default("RECEIVED")
  receivedAt      DateTime  @default(now()) @map("received_at")
  processedAt     DateTime? @map("processed_at")
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages        Message[]

  @@unique([tenantId, provider, externalEventId])
  @@index([status, receivedAt])
  @@map("webhook_events")
}

model Conversation {
  id                     String    @id @default(uuid()) @db.Uuid
  tenantId               String    @map("tenant_id") @db.Uuid
  channel                String
  externalConversationId String    @map("external_conversation_id")
  participantId          String    @map("participant_id")
  displayName            String?   @map("display_name")
  lastMessageAt          DateTime  @map("last_message_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")
  tenant                 Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages               Message[]
  orders                 Order[]

  @@unique([tenantId, channel, externalConversationId])
  @@index([tenantId, lastMessageAt])
  @@map("conversations")
}

model Message {
  id                String       @id @default(uuid()) @db.Uuid
  tenantId          String       @map("tenant_id") @db.Uuid
  conversationId    String       @map("conversation_id") @db.Uuid
  rawEventId        String       @map("raw_event_id") @db.Uuid
  channel           String
  externalMessageId String       @map("external_message_id")
  direction         String
  senderId          String       @map("sender_id")
  text              String?
  sourceTimestamp   DateTime     @map("source_timestamp")
  createdAt         DateTime     @default(now()) @map("created_at")
  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  rawEvent          WebhookEvent @relation(fields: [rawEventId], references: [id], onDelete: Restrict)
  attachments       Attachment[]
  triggeredOrders   Order[]      @relation("OrderTriggerMessage")

  @@unique([tenantId, channel, externalMessageId])
  @@index([conversationId, sourceTimestamp])
  @@map("messages")
}

model TenantSettings {
  id                    String   @id @default(uuid()) @db.Uuid
  tenantId              String   @unique @map("tenant_id") @db.Uuid
  approvalMode          String   @default("ALWAYS") @map("approval_mode")
  autoApprovalThreshold Float    @default(0.9) @map("auto_approval_threshold")
  promptVersion         String   @default("instagram-order-v1") @map("prompt_version")
  triggerPhrases        Json     @map("trigger_phrases")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

model Order {
  id                String      @id @default(uuid()) @db.Uuid
  tenantId          String      @map("tenant_id") @db.Uuid
  conversationId    String      @map("conversation_id") @db.Uuid
  triggerMessageId  String      @unique @map("trigger_message_id") @db.Uuid
  status            String      @default("AI_PROCESSING")
  extraction        Json?
  validationIssues  Json?       @map("validation_issues")
  overallConfidence Float?      @map("overall_confidence")
  aiResponseId      String?     @map("ai_response_id")
  aiModel           String?     @map("ai_model")
  promptVersion     String      @map("prompt_version")
  inputTokens       Int?        @map("input_tokens")
  outputTokens      Int?        @map("output_tokens")
  approvedAt        DateTime?   @map("approved_at")
  approvedBy        String?     @map("approved_by")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")
  tenant            Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  triggerMessage    Message     @relation("OrderTriggerMessage", fields: [triggerMessageId], references: [id], onDelete: Restrict)
  items             OrderItem[]

  @@index([tenantId, status, createdAt])
  @@index([conversationId, createdAt])
  @@map("orders")
}

model OrderItem {
  id           String   @id @default(uuid()) @db.Uuid
  orderId      String   @map("order_id") @db.Uuid
  catalogId    String?  @map("catalog_id")
  originalText String   @map("original_text")
  quantity     Int
  color        String?
  size         String?
  confidence   Float
  createdAt    DateTime @default(now()) @map("created_at")
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_items")
}

model Product {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  sku       String
  name      String
  aliases   Json
  imageUrl  String?  @map("image_url")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sku])
  @@index([tenantId, active, name])
  @@map("products")
}

model Attachment {
  id             String   @id @default(uuid()) @db.Uuid
  messageId      String   @map("message_id") @db.Uuid
  type           String
  originalUrl    String   @map("original_url")
  storageKey     String?  @map("storage_key")
  checksum       String?
  copyStatus     String   @default("PENDING") @map("copy_status")
  failureSummary String?  @map("failure_summary")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  message        Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([copyStatus, createdAt])
  @@index([checksum])
  @@map("attachments")
}
