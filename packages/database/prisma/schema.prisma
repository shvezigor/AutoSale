generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  generatedFileExtension = "ts"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum PlatformRole {
  USER
  PLATFORM_ADMIN
}

enum MembershipRole {
  OWNER
  MANAGER
}

enum AccessStatus {
  PENDING
  ACTIVE
  BLOCKED
}

enum InstagramConnectionStatus {
  LEGACY
  ACTIVE
  REAUTH_REQUIRED
  ERROR
  DISCONNECTED
}

model Tenant {
  id        String         @id @default(uuid()) @db.Uuid
  key       String         @unique
  name      String
  status    AccessStatus   @default(ACTIVE)
  createdAt DateTime       @default(now()) @map("created_at")
  events    WebhookEvent[]
  conversations Conversation[]
  messages      Message[]
  settings      TenantSettings?
  orders        Order[]
  products      Product[]
  auditLogs     AuditLog[]
  sheetsDestination GoogleSheetsDestination?
  orderExports      OrderExport[]
  memberships       TenantMembership[]
  sessions          Session[]
  invitations       TenantInvitation[]
  securityAuditLogs SecurityAuditLog[]
  instagramConnection InstagramConnection?
  instagramOAuthStates InstagramOAuthState[]

  @@index([status])
  @@map("tenants")
}

model InstagramConnection {
  id                   String                    @id @default(uuid()) @db.Uuid
  tenantId             String                    @unique @map("tenant_id") @db.Uuid
  externalAccountId    String                    @unique @map("external_account_id")
  displayName          String?                   @map("display_name")
  status               InstagramConnectionStatus @default(LEGACY)
  encryptedAccessToken String?                   @map("encrypted_access_token")
  tokenExpiresAt       DateTime?                 @map("token_expires_at")
  grantedScopes        String?                   @map("granted_scopes")
  lastVerifiedAt       DateTime?                 @map("last_verified_at")
  lastErrorCode        String?                   @map("last_error_code")
  connectedByUserId    String?                   @map("connected_by_user_id") @db.Uuid
  disconnectedAt       DateTime?                 @map("disconnected_at")
  createdAt            DateTime                  @default(now()) @map("created_at")
  updatedAt            DateTime                  @updatedAt @map("updated_at")
  tenant               Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connectedBy          User?                     @relation("InstagramConnectionConnectedBy", fields: [connectedByUserId], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("instagram_connections")
}

model InstagramOAuthState {
  id         String    @id @default(uuid()) @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  tenantId   String    @map("tenant_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  returnPath String    @default("/settings") @map("return_path")
  expiresAt  DateTime  @map("expires_at")
  usedAt     DateTime? @map("used_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt, usedAt])
  @@map("instagram_oauth_states")
}

model User {
  id                      String                   @id @default(uuid()) @db.Uuid
  email                   String                   @unique
  name                    String
  passwordHash            String                   @map("password_hash")
  emailVerifiedAt         DateTime?                @map("email_verified_at")
  platformRole            PlatformRole             @default(USER) @map("platform_role")
  status                  AccessStatus              @default(PENDING)
  createdAt               DateTime                  @default(now()) @map("created_at")
  updatedAt               DateTime                  @updatedAt @map("updated_at")
  memberships             TenantMembership[]
  sessions                Session[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  invitationsCreated      TenantInvitation[]       @relation("InvitationCreator")
  securityAuditLogs       SecurityAuditLog[]
  instagramOAuthStates    InstagramOAuthState[]
  instagramConnections    InstagramConnection[]    @relation("InstagramConnectionConnectedBy")

  @@index([status])
  @@map("users")
}

model TenantMembership {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  role      MembershipRole
  status    AccessStatus   @default(PENDING)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId, status])
  @@map("tenant_memberships")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tenantId  String?   @map("tenant_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  ipPrefix  String?   @map("ip_prefix")
  userAgent String?   @map("user_agent")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, revokedAt])
  @@map("sessions")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model TenantInvitation {
  id          String         @id @default(uuid()) @db.Uuid
  tenantId    String         @map("tenant_id") @db.Uuid
  email       String
  role        MembershipRole @default(MANAGER)
  tokenHash   String         @unique @map("token_hash")
  invitedById String         @map("invited_by_id") @db.Uuid
  expiresAt   DateTime       @map("expires_at")
  usedAt      DateTime?      @map("used_at")
  revokedAt   DateTime?      @map("revoked_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy   User           @relation("InvitationCreator", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([tenantId, email, expiresAt])
  @@map("tenant_invitations")
}

model SecurityAuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  tenantId  String?  @map("tenant_id") @db.Uuid
  actor     String
  action    String
  result    String
  metadata  Json
  createdAt DateTime @default(now()) @map("created_at")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
  @@map("security_audit_logs")
}

model WebhookEvent {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  provider        String
  externalEventId String    @map("external_event_id")
  payload         Json
  status          String    @default("RECEIVED")
  receivedAt      DateTime  @default(now()) @map("received_at")
  processedAt     DateTime? @map("processed_at")
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages        Message[]

  @@unique([tenantId, provider, externalEventId])
  @@index([status, receivedAt])
  @@map("webhook_events")
}

model Conversation {
  id                     String    @id @default(uuid()) @db.Uuid
  tenantId               String    @map("tenant_id") @db.Uuid
  channel                String
  externalConversationId String    @map("external_conversation_id")
  participantId          String    @map("participant_id")
  displayName            String?   @map("display_name")
  lastMessageAt          DateTime  @map("last_message_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")
  tenant                 Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages               Message[]
  orders                 Order[]

  @@unique([tenantId, channel, externalConversationId])
  @@index([tenantId, lastMessageAt])
  @@map("conversations")
}

model Message {
  id                String       @id @default(uuid()) @db.Uuid
  tenantId          String       @map("tenant_id") @db.Uuid
  conversationId    String       @map("conversation_id") @db.Uuid
  rawEventId        String       @map("raw_event_id") @db.Uuid
  channel           String
  externalMessageId String       @map("external_message_id")
  direction         String
  senderId          String       @map("sender_id")
  text              String?
  sourceTimestamp   DateTime     @map("source_timestamp")
  createdAt         DateTime     @default(now()) @map("created_at")
  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  rawEvent          WebhookEvent @relation(fields: [rawEventId], references: [id], onDelete: Restrict)
  attachments       Attachment[]
  triggeredOrders   Order[]      @relation("OrderTriggerMessage")

  @@unique([tenantId, channel, externalMessageId])
  @@index([conversationId, sourceTimestamp])
  @@map("messages")
}

model GoogleSheetsDestination {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @unique @map("tenant_id") @db.Uuid
  spreadsheetId   String    @map("spreadsheet_id")
  sheetName       String    @map("sheet_name")
  requiredHeaders Json      @map("required_headers")
  status          String    @default("PENDING")
  lastValidatedAt DateTime? @map("last_validated_at")
  errorSummary    String?   @map("error_summary")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  exports         OrderExport[]

  @@map("google_sheets_destinations")
}

model TenantSettings {
  id                    String   @id @default(uuid()) @db.Uuid
  tenantId              String   @unique @map("tenant_id") @db.Uuid
  approvalMode          String   @default("ALWAYS") @map("approval_mode")
  autoApprovalThreshold Float    @default(0.9) @map("auto_approval_threshold")
  promptVersion         String   @default("instagram-order-v1") @map("prompt_version")
  triggerPhrases        Json     @map("trigger_phrases")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

model Order {
  id                String      @id @default(uuid()) @db.Uuid
  tenantId          String      @map("tenant_id") @db.Uuid
  conversationId    String      @map("conversation_id") @db.Uuid
  triggerMessageId  String      @unique @map("trigger_message_id") @db.Uuid
  status            String      @default("AI_PROCESSING")
  extraction        Json?
  validationIssues  Json?       @map("validation_issues")
  overallConfidence Float?      @map("overall_confidence")
  aiResponseId      String?     @map("ai_response_id")
  aiModel           String?     @map("ai_model")
  promptVersion     String      @map("prompt_version")
  inputTokens       Int?        @map("input_tokens")
  outputTokens      Int?        @map("output_tokens")
  approvedAt        DateTime?   @map("approved_at")
  approvedBy        String?     @map("approved_by")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")
  tenant            Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  triggerMessage    Message     @relation("OrderTriggerMessage", fields: [triggerMessageId], references: [id], onDelete: Restrict)
  items             OrderItem[]
  auditLogs         AuditLog[]
  exports           OrderExport[]

  @@index([tenantId, status, createdAt])
  @@index([conversationId, createdAt])
  @@map("orders")
}

model OrderExport {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  orderId       String    @map("order_id") @db.Uuid
  destinationId String    @map("destination_id") @db.Uuid
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  rowNumber     Int?      @map("row_number")
  lastAttemptAt DateTime? @map("last_attempt_at")
  lastSyncedAt  DateTime? @map("last_synced_at")
  errorSummary  String?   @map("error_summary")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  destination   GoogleSheetsDestination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([orderId, destinationId])
  @@index([status, updatedAt])
  @@map("order_exports")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  actor     String
  action    String
  changes   Json
  createdAt DateTime @default(now()) @map("created_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("audit_logs")
}

model OrderItem {
  id           String   @id @default(uuid()) @db.Uuid
  orderId      String   @map("order_id") @db.Uuid
  catalogId    String?  @map("catalog_id")
  originalText String   @map("original_text")
  quantity     Int
  color        String?
  size         String?
  confidence   Float
  createdAt    DateTime @default(now()) @map("created_at")
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_items")
}

model Product {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  sku       String
  name      String
  aliases   Json
  imageUrl  String?  @map("image_url")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sku])
  @@index([tenantId, active, name])
  @@map("products")
}

model Attachment {
  id             String   @id @default(uuid()) @db.Uuid
  messageId      String   @map("message_id") @db.Uuid
  type           String
  originalUrl    String   @map("original_url")
  storageKey     String?  @map("storage_key")
  checksum       String?
  copyStatus     String   @default("PENDING") @map("copy_status")
  failureSummary String?  @map("failure_summary")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  message        Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([copyStatus, createdAt])
  @@index([checksum])
  @@map("attachments")
}
