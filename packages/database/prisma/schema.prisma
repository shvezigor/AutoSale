generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  generatedFileExtension = "ts"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum PlatformRole {
  USER
  PLATFORM_ADMIN
}

enum MembershipRole {
  OWNER
  MANAGER
}

enum AccessStatus {
  PENDING
  ACTIVE
  BLOCKED
}

enum InstagramConnectionStatus {
  LEGACY
  ACTIVE
  REAUTH_REQUIRED
  ERROR
  DISCONNECTED
}

enum InstagramCredentialCleanupOperationStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum InstagramCredentialCleanupState {
  ARMED
  REQUIRED
  COMPLETED
  CANCELLED
  DEAD_LETTER
}

enum CatalogueSourceType {
  XLSX_UPLOAD
  CSV_UPLOAD
  GOOGLE_SHEETS
}

enum CatalogueSourceStatus {
  PENDING
  ACTIVE
  PAUSED
  ERROR
  DISCONNECTED
}

enum CatalogueImportStatus {
  UPLOADED
  MAPPING
  MAPPING_REVIEW
  PREVIEW_READY
  CONFIRMED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model Tenant {
  id        String         @id @default(uuid()) @db.Uuid
  key       String         @unique
  name      String
  status    AccessStatus   @default(ACTIVE)
  createdAt DateTime       @default(now()) @map("created_at")
  events    WebhookEvent[]
  conversations Conversation[]
  messages      Message[]
  settings      TenantSettings?
  orders        Order[]
  products      Product[]
  catalogueSources CatalogueSource[]
  catalogueMappings CatalogueMapping[]
  catalogueImportRuns CatalogueImportRun[]
  auditLogs     AuditLog[]
  sheetsDestination GoogleSheetsDestination?
  orderExports      OrderExport[]
  memberships       TenantMembership[]
  sessions          Session[]
  invitations       TenantInvitation[]
  securityAuditLogs SecurityAuditLog[]
  instagramConnection InstagramConnection?
  instagramOAuthStates InstagramOAuthState[]
  instagramCredentialCleanups InstagramCredentialCleanup[]
  instagramCustomerProfiles InstagramCustomerProfile[]
  instagramOAuthCurrentAttemptId String? @db.Uuid @map("instagram_oauth_current_attempt_id")

  @@index([status])
  @@map("tenants")
}

model InstagramConnection {
  id                   String                    @id @default(uuid()) @db.Uuid
  tenantId             String                    @unique @map("tenant_id") @db.Uuid
  externalAccountId    String                    @unique @map("external_account_id")
  displayName          String?                   @map("display_name")
  status               InstagramConnectionStatus @default(LEGACY)
  encryptedAccessToken String?                   @map("encrypted_access_token")
  credentialGenerationId String?                 @unique @map("credential_generation_id") @db.Uuid
  tokenExpiresAt       DateTime?                 @map("token_expires_at")
  grantedScopes        String?                   @map("granted_scopes")
  lastVerifiedAt       DateTime?                 @map("last_verified_at")
  lastErrorCode        String?                   @map("last_error_code")
  connectedByUserId    String?                   @map("connected_by_user_id") @db.Uuid
  disconnectedAt       DateTime?                 @map("disconnected_at")
  createdAt            DateTime                  @default(now()) @map("created_at")
  updatedAt            DateTime                  @updatedAt @map("updated_at")
  tenant               Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connectedBy          User?                     @relation("InstagramConnectionConnectedBy", fields: [connectedByUserId], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("instagram_connections")
}

model InstagramOAuthState {
  id         String    @id @default(uuid()) @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  tenantId   String    @map("tenant_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  returnPath String    @default("/settings") @map("return_path")
  expiresAt  DateTime  @map("expires_at")
  usedAt     DateTime? @map("used_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt, usedAt])
  @@map("instagram_oauth_states")
}

model InstagramCredentialCleanup {
  id                       String                                    @id @default(uuid()) @db.Uuid
  credentialGenerationId   String                                    @unique @map("credential_generation_id") @db.Uuid
  tenantId                 String                                    @map("tenant_id") @db.Uuid
  externalAccountId        String                                    @map("external_account_id")
  encryptedAccessToken     String                                    @map("encrypted_access_token")
  source                   String                                    @default("DISCONNECT")
  state                    InstagramCredentialCleanupState           @default(ARMED)
  callbackResolvedAt       DateTime?                                 @map("callback_resolved_at")
  unsubscribeStatus        InstagramCredentialCleanupOperationStatus @default(PENDING) @map("unsubscribe_status")
  unsubscribeAttemptedAt   DateTime?                                 @map("unsubscribe_attempted_at")
  unsubscribeSucceededAt   DateTime?                                 @map("unsubscribe_succeeded_at")
  revokeStatus             InstagramCredentialCleanupOperationStatus @default(PENDING) @map("revoke_status")
  revokeAttemptedAt        DateTime?                                 @map("revoke_attempted_at")
  revokeSucceededAt        DateTime?                                 @map("revoke_succeeded_at")
  attempts                 Int                                       @default(0)
  leaseId                  String?                                   @map("lease_id") @db.Uuid
  leaseExpiresAt           DateTime?                                 @map("lease_expires_at")
  version                  Int                                       @default(0)
  lastErrorCode            String?                                   @map("last_error_code")
  permanentFailureAt       DateTime?                                 @map("permanent_failure_at")
  deadLetteredAt           DateTime?                                 @map("dead_lettered_at")
  deadLetteredByUserId     String?                                   @map("dead_lettered_by_user_id") @db.Uuid
  terminalAt               DateTime?                                 @map("terminal_at")
  createdAt                DateTime                                  @default(now()) @map("created_at")
  updatedAt                DateTime                                  @updatedAt @map("updated_at")
  tenant                   Tenant                                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deadLetteredBy           User?                                     @relation("InstagramCleanupDeadLetteredBy", fields: [deadLetteredByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, terminalAt])
  @@index([leaseExpiresAt])
  @@map("instagram_credential_cleanups")
}

model User {
  id                      String                   @id @default(uuid()) @db.Uuid
  email                   String                   @unique
  name                    String
  passwordHash            String                   @map("password_hash")
  emailVerifiedAt         DateTime?                @map("email_verified_at")
  platformRole            PlatformRole             @default(USER) @map("platform_role")
  status                  AccessStatus              @default(PENDING)
  createdAt               DateTime                  @default(now()) @map("created_at")
  updatedAt               DateTime                  @updatedAt @map("updated_at")
  memberships             TenantMembership[]
  sessions                Session[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  invitationsCreated      TenantInvitation[]       @relation("InvitationCreator")
  securityAuditLogs       SecurityAuditLog[]
  instagramOAuthStates    InstagramOAuthState[]
  instagramConnections    InstagramConnection[]    @relation("InstagramConnectionConnectedBy")
  instagramCleanupsDeadLettered InstagramCredentialCleanup[] @relation("InstagramCleanupDeadLetteredBy")

  @@index([status])
  @@map("users")
}

model TenantMembership {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  role      MembershipRole
  status    AccessStatus   @default(PENDING)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId, status])
  @@map("tenant_memberships")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tenantId  String?   @map("tenant_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  ipPrefix  String?   @map("ip_prefix")
  userAgent String?   @map("user_agent")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, revokedAt])
  @@map("sessions")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model TenantInvitation {
  id          String         @id @default(uuid()) @db.Uuid
  tenantId    String         @map("tenant_id") @db.Uuid
  email       String
  role        MembershipRole @default(MANAGER)
  tokenHash   String         @unique @map("token_hash")
  invitedById String         @map("invited_by_id") @db.Uuid
  expiresAt   DateTime       @map("expires_at")
  usedAt      DateTime?      @map("used_at")
  revokedAt   DateTime?      @map("revoked_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy   User           @relation("InvitationCreator", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([tenantId, email, expiresAt])
  @@map("tenant_invitations")
}

model SecurityAuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  tenantId  String?  @map("tenant_id") @db.Uuid
  actor     String
  action    String
  result    String
  metadata  Json
  createdAt DateTime @default(now()) @map("created_at")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
  @@map("security_audit_logs")
}

model WebhookEvent {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  provider        String
  externalEventId String    @map("external_event_id")
  payload         Json
  status          String    @default("RECEIVED")
  receivedAt      DateTime  @default(now()) @map("received_at")
  processedAt     DateTime? @map("processed_at")
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages        Message[]

  @@unique([tenantId, provider, externalEventId])
  @@index([status, receivedAt])
  @@map("webhook_events")
}

model Conversation {
  id                     String    @id @default(uuid()) @db.Uuid
  tenantId               String    @map("tenant_id") @db.Uuid
  channel                String
  externalConversationId String    @map("external_conversation_id")
  participantId          String    @map("participant_id")
  profileId              String?   @map("profile_id") @db.Uuid
  displayName            String?   @map("display_name")
  lastMessageAt          DateTime  @map("last_message_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")
  tenant                 Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  profile                InstagramCustomerProfile? @relation(fields: [tenantId, profileId], references: [tenantId, id], onDelete: Restrict)
  messages               Message[]
  orders                 Order[]

  @@unique([tenantId, channel, externalConversationId])
  @@index([tenantId, lastMessageAt])
  @@map("conversations")
}

model InstagramCustomerProfile {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  participantId      String    @map("participant_id")
  displayName        String?   @map("display_name")
  username           String?
  avatarSourceUrl    String?   @map("avatar_source_url")
  avatarStorageKey   String?   @map("avatar_storage_key")
  avatarChecksum     String?   @map("avatar_checksum")
  avatarContentType  String?   @map("avatar_content_type")
  status             String    @default("PENDING")
  refreshVersion     Int       @default(1) @map("refresh_version")
  attempts           Int       @default(0)
  nextAttemptAt      DateTime  @default(now()) @map("next_attempt_at")
  refreshAfter       DateTime? @map("refresh_after")
  leaseId            String?   @map("lease_id") @db.Uuid
  leaseExpiresAt     DateTime? @map("lease_expires_at")
  lastErrorCode      String?   @map("last_error_code")
  lastRefreshedAt    DateTime? @map("last_refreshed_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations      Conversation[]

  @@unique([tenantId, participantId])
  @@unique([tenantId, id])
  @@index([status, nextAttemptAt])
  @@index([status, refreshAfter])
  @@map("instagram_customer_profiles")
}

model InstagramAvatarCleanup {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  storageKey     String   @unique @map("storage_key")
  status         String   @default("PENDING")
  attempts       Int      @default(0)
  nextAttemptAt  DateTime @default(now()) @map("next_attempt_at")
  leaseId        String?  @map("lease_id") @db.Uuid
  leaseExpiresAt DateTime? @map("lease_expires_at")
  lastErrorCode  String?  @map("last_error_code")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([status, nextAttemptAt])
  @@map("instagram_avatar_cleanups")
}

model Message {
  id                String       @id @default(uuid()) @db.Uuid
  tenantId          String       @map("tenant_id") @db.Uuid
  conversationId    String       @map("conversation_id") @db.Uuid
  rawEventId        String       @map("raw_event_id") @db.Uuid
  channel           String
  externalMessageId String       @map("external_message_id")
  direction         String
  senderId          String       @map("sender_id")
  text              String?
  sourceTimestamp   DateTime     @map("source_timestamp")
  createdAt         DateTime     @default(now()) @map("created_at")
  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  rawEvent          WebhookEvent @relation(fields: [rawEventId], references: [id], onDelete: Restrict)
  attachments       Attachment[]
  triggeredOrders   Order[]      @relation("OrderTriggerMessage")

  @@unique([tenantId, channel, externalMessageId])
  @@index([conversationId, sourceTimestamp])
  @@map("messages")
}

model GoogleSheetsDestination {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @unique @map("tenant_id") @db.Uuid
  spreadsheetId   String    @map("spreadsheet_id")
  sheetName       String    @map("sheet_name")
  requiredHeaders Json      @map("required_headers")
  status          String    @default("PENDING")
  lastValidatedAt DateTime? @map("last_validated_at")
  errorSummary    String?   @map("error_summary")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  exports         OrderExport[]

  @@map("google_sheets_destinations")
}

model TenantSettings {
  id                    String   @id @default(uuid()) @db.Uuid
  tenantId              String   @unique @map("tenant_id") @db.Uuid
  approvalMode          String   @default("ALWAYS") @map("approval_mode")
  autoApprovalThreshold Float    @default(0.9) @map("auto_approval_threshold")
  promptVersion         String   @default("instagram-order-v1") @map("prompt_version")
  triggerPhrases        Json     @map("trigger_phrases")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

model Order {
  id                String      @id @default(uuid()) @db.Uuid
  tenantId          String      @map("tenant_id") @db.Uuid
  conversationId    String      @map("conversation_id") @db.Uuid
  triggerMessageId  String      @unique @map("trigger_message_id") @db.Uuid
  status            String      @default("AI_PROCESSING")
  extraction        Json?
  validationIssues  Json?       @map("validation_issues")
  overallConfidence Float?      @map("overall_confidence")
  aiResponseId      String?     @map("ai_response_id")
  aiModel           String?     @map("ai_model")
  promptVersion     String      @map("prompt_version")
  inputTokens       Int?        @map("input_tokens")
  outputTokens      Int?        @map("output_tokens")
  approvedAt        DateTime?   @map("approved_at")
  approvedBy        String?     @map("approved_by")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")
  tenant            Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  triggerMessage    Message     @relation("OrderTriggerMessage", fields: [triggerMessageId], references: [id], onDelete: Restrict)
  items             OrderItem[]
  auditLogs         AuditLog[]
  exports           OrderExport[]

  @@index([tenantId, status, createdAt])
  @@index([conversationId, createdAt])
  @@map("orders")
}

model OrderExport {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  orderId       String    @map("order_id") @db.Uuid
  destinationId String    @map("destination_id") @db.Uuid
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  rowNumber     Int?      @map("row_number")
  lastAttemptAt DateTime? @map("last_attempt_at")
  lastSyncedAt  DateTime? @map("last_synced_at")
  errorSummary  String?   @map("error_summary")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  destination   GoogleSheetsDestination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([orderId, destinationId])
  @@index([status, updatedAt])
  @@map("order_exports")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  actor     String
  action    String
  changes   Json
  createdAt DateTime @default(now()) @map("created_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("audit_logs")
}

model OrderItem {
  id           String   @id @default(uuid()) @db.Uuid
  orderId      String   @map("order_id") @db.Uuid
  catalogId    String?  @map("catalog_id")
  originalText String   @map("original_text")
  quantity     Int
  color        String?
  size         String?
  confidence   Float
  createdAt    DateTime @default(now()) @map("created_at")
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_items")
}

model Product {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  sku             String
  name            String
  description     String?
  price           Decimal?         @db.Decimal(12, 2)
  currency        String?          @db.VarChar(3)
  stockQuantity   Int?             @map("stock_quantity")
  category        String?
  brand           String?
  aliases         Json
  color           String?
  size            String?
  imageUrls       Json?            @map("image_urls")
  attributes      Json?
  imageUrl        String?          @map("image_url")
  active          Boolean          @default(true)
  sourceId        String?          @map("source_id") @db.Uuid
  sourceRowKey    String?          @map("source_row_key")
  sourceUpdatedAt DateTime?        @map("source_updated_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  source          CatalogueSource? @relation("ProductSource", fields: [tenantId, sourceId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, sku])
  @@index([tenantId, active, name])
  @@map("products")
}

model CatalogueSource {
  id               String                 @id @default(uuid()) @db.Uuid
  tenantId         String                 @map("tenant_id") @db.Uuid
  type             CatalogueSourceType
  displayName      String                 @map("display_name")
  status           CatalogueSourceStatus  @default(PENDING)
  createdByUserId  String?                @map("created_by_user_id") @db.Uuid
  spreadsheetId    String?                @map("spreadsheet_id")
  sheetName        String?                @map("sheet_name")
  credentialRef    String?                @map("credential_ref")
  objectKey        String?                @map("object_key")
  syncSchedule     String?                @map("sync_schedule")
  headerFingerprint String?               @map("header_fingerprint")
  lastSyncedAt     DateTime?              @map("last_synced_at")
  nextSyncAt       DateTime?              @map("next_sync_at")
  lastErrorSummary String?                @map("last_error_summary")
  syncLeaseId      String?                @map("sync_lease_id") @db.Uuid
  syncLeaseExpiresAt DateTime?            @map("sync_lease_expires_at")
  syncVersion      Int                    @default(0) @map("sync_version")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")
  tenant           Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products         Product[]               @relation("ProductSource")
  mappings         CatalogueMapping[]
  importRuns       CatalogueImportRun[]

  @@index([tenantId, status])
  @@index([type, status, nextSyncAt, id])
  @@unique([tenantId, id])
  @@map("catalogue_sources")
}

model CatalogueMapping {
  id                String            @id @default(uuid()) @db.Uuid
  tenantId          String            @map("tenant_id") @db.Uuid
  sourceId          String            @map("source_id") @db.Uuid
  version           Int
  sourceFingerprint String            @map("source_fingerprint")
  columns           Json
  transformSettings Json?             @map("transform_settings")
  aiModel           String?           @map("ai_model")
  promptVersion     String?           @map("prompt_version")
  schemaVersion     String?           @map("schema_version")
  aiLatencyMs       Int?              @map("ai_latency_ms")
  aiInputTokens     Int?              @map("ai_input_tokens")
  aiOutputTokens    Int?              @map("ai_output_tokens")
  ownerModified     Boolean           @default(false) @map("owner_modified")
  confirmedAt       DateTime?         @map("confirmed_at")
  confirmedByUserId String?           @map("confirmed_by_user_id") @db.Uuid
  createdAt         DateTime          @default(now()) @map("created_at")
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  source            CatalogueSource   @relation(fields: [tenantId, sourceId], references: [tenantId, id], onDelete: Cascade)
  importRuns        CatalogueImportRun[]

  @@unique([sourceId, version])
  @@unique([tenantId, id])
  @@index([tenantId, sourceId])
  @@map("catalogue_mappings")
}

model CatalogueImportRun {
  id              String                 @id @default(uuid()) @db.Uuid
  tenantId        String                 @map("tenant_id") @db.Uuid
  sourceId        String                 @map("source_id") @db.Uuid
  mappingId       String?                @map("mapping_id") @db.Uuid
  mappingLeaseId  String?                @map("mapping_lease_id") @db.Uuid
  mappingLeaseExpiresAt DateTime?        @map("mapping_lease_expires_at")
  requestedByUserId String?              @map("requested_by_user_id") @db.Uuid
  status          CatalogueImportStatus  @default(UPLOADED)
  idempotencyKey  String                 @map("idempotency_key")
  sourceRevision  String?                @map("source_revision")
  sourceHeaders   Json?                  @map("source_headers")
  snapshotObjectKey String?              @map("snapshot_object_key")
  sourceSyncVersion Int?                 @map("source_sync_version")
  totalRows       Int                    @default(0) @map("total_rows")
  validRows       Int                    @default(0) @map("valid_rows")
  createdRows     Int                    @default(0) @map("created_rows")
  updatedRows     Int                    @default(0) @map("updated_rows")
  skippedRows     Int                    @default(0) @map("skipped_rows")
  failedRows      Int                    @default(0) @map("failed_rows")
  rowErrors       Json?                  @map("row_errors")
  startedAt       DateTime?              @map("started_at")
  completedAt     DateTime?              @map("completed_at")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  source          CatalogueSource        @relation(fields: [tenantId, sourceId], references: [tenantId, id], onDelete: Cascade)
  mapping         CatalogueMapping?      @relation(fields: [tenantId, mappingId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, idempotencyKey])
  @@index([sourceId, createdAt])
  @@index([status, mappingLeaseExpiresAt])
  @@map("catalogue_import_runs")
}

model Attachment {
  id             String   @id @default(uuid()) @db.Uuid
  messageId      String   @map("message_id") @db.Uuid
  type           String
  originalUrl    String   @map("original_url")
  storageKey     String?  @map("storage_key")
  checksum       String?
  copyStatus     String   @default("PENDING") @map("copy_status")
  failureSummary String?  @map("failure_summary")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  message        Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([copyStatus, createdAt])
  @@index([checksum])
  @@map("attachments")
}
