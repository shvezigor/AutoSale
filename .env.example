NODE_ENV=development
POSTGRES_DB=autosale
POSTGRES_USER=autosale
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://autosale:replace-with-a-long-random-password@postgres:5432/autosale
REDIS_URL=redis://redis:6379
DEFAULT_TENANT_ID=11111111-1111-4111-8111-111111111111
DEFAULT_TENANT_KEY=default
META_VERIFY_TOKEN=replace-with-at-least-24-characters
META_APP_SECRET=replace-with-meta-app-secret
MINIO_ROOT_USER=replace-with-minio-access-key
MINIO_ROOT_PASSWORD=replace-with-minio-secret-key
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=autosale-media
S3_ACCESS_KEY_ID=replace-with-minio-access-key
S3_SECRET_ACCESS_KEY=replace-with-minio-secret-key
